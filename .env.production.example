# Copy to .env.production and provide deployment-specific values.
JARVIS_ENV=production
HOST=0.0.0.0
PORT=8000
JARVIS_SECRET_KEY=replace-with-at-least-32-random-characters
JARVIS_DB__URL=sqlite+aiosqlite:////app/data/app.db
ALLOWED_ORIGINS=https://your.example.com
OLLAMA_URL=http://ollama:11434
CHAT_MODEL=ollama/qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
QDRANT_HOST=qdrant
LOG_LEVEL=INFO
